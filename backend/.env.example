# ---- Server ----
PORT=4000
# at least 32 random characters; the server refuses to start in production without one.
# make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_long_random_string

# ---- Accounts ----
# accounts with these emails (comma-separated) can open the admin panel
ADMIN_EMAILS=
# address of the frontend; used in the links inside emails
APP_URL=http://localhost:3000
# origins allowed to call this API from a browser (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
# if set, registering needs this code (keeps strangers from using your LLM key)
REGISTRATION_INVITE_CODE=
# new accounts must confirm their email before signing in (true/false)
REQUIRE_EMAIL_VERIFICATION=true
# Brevo API key and a sender address verified in Brevo. Leave empty to print the links to this log.
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=StudyMate
# cookies need HTTPS when true; defaults to true when NODE_ENV=production
COOKIE_SECURE=
# proxies in front of this server (Railway: 1)
TRUST_PROXY=1

# ---- Cassandra ----
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_KEYSPACE=studymate
# Leave blank for a default local cluster with no auth:
CASSANDRA_USER=
CASSANDRA_PASSWORD=
# LOCAL_QUORUM (default) reads and writes a majority of replicas; with replication factor 3 the
# app keeps working while one node is down. Use LOCAL_ONE only if you want speed over consistency.
CASSANDRA_CONSISTENCY=LOCAL_QUORUM
# used by "npm run setup-db": "datacenter1:3" puts a copy of every row on each of 3 nodes.
# Leave empty on a single node.
CASSANDRA_REPLICATION=

# ---- AI / LLM provider (for summaries, Q&A, quiz gen, and grading) ----
# LLM_PROVIDER options: none | anthropic | openai | gemini | ollama
# When 'none' (or no API key), the app runs in deterministic fallback mode
# so every feature still works end-to-end for development and demos.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_ENDPOINT=

# ---- Retrieval sidecar (smdb; see the StudyMateDb repository) ----
# When enabled, chat and the evaluator send the LLM only the chunks relevant to the
# question instead of the whole document. If the sidecar is down or a document is not
# indexed yet, the app falls back to the whole document automatically.
RETRIEVAL_ENABLED=false
RETRIEVAL_URL=http://127.0.0.1:8100
RETRIEVAL_TOP_K=5
RETRIEVAL_TIMEOUT_MS=8000
